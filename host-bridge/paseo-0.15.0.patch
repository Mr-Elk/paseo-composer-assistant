@@ -0,0 +1,131 @@
+import { describe, expect, it } from "vitest";
+import type { InstalledPlugin } from "../types";
+import { PluginComposerStatusStore } from "./store";
+
+function installation(id = "review", serverId = "host-a"): InstalledPlugin {
+  return { id, serverId } as unknown as InstalledPlugin;
+}
+
+function component() {
+  return () => null;
+}
+
+describe("PluginComposerStatusStore", () => {
+  it("registers a row only for its own host, workspace, and agent", () => {
+    const store = new PluginComposerStatusStore();
+    const Component = component();
+    store.add(installation(), {
+      id: "insights",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component,
+    });
+    const entries = store.getSnapshot();
+    expect(entries).toHaveLength(1);
+    expect(entries[0]).toMatchObject({ id: "insights", workspaceId: "wks-1", agentId: "agent-1" });
+  });
+
+  it("rejects duplicate ids for the same target and keeps other agents apart", () => {
+    const store = new PluginComposerStatusStore();
+    const source = installation();
+    store.add(source, {
+      id: "insights",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component: component(),
+    });
+    expect(() =>
+      store.add(source, {
+        id: "insights",
+        workspaceId: "wks-1",
+        agentId: "agent-1",
+        Component: component(),
+      }),
+    ).toThrow(/Duplicate composer status/);
+    expect(() =>
+      store.add(source, {
+        id: "insights",
+        workspaceId: "wks-1",
+        agentId: "agent-2",
+        Component: component(),
+      }),
+    ).not.toThrow();
+  });
+
+  it("validates ids and components", () => {
+    const store = new PluginComposerStatusStore();
+    const source = installation();
+    expect(() =>
+      store.add(source, {
+        id: "Bad Id",
+        workspaceId: "wks-1",
+        agentId: "agent-1",
+        Component: component(),
+      }),
+    ).toThrow(/Invalid composer status id/);
+    expect(() =>
+      store.add(source, {
+        id: "insights",
+        workspaceId: "wks-1",
+        agentId: "agent-1",
+        Component: undefined as never,
+      }),
+    ).toThrow(/not a component/);
+  });
+
+  it("removes one registration without touching the others", () => {
+    const store = new PluginComposerStatusStore();
+    const source = installation();
+    const registration = store.add(source, {
+      id: "insights",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component: component(),
+    });
+    store.add(source, {
+      id: "assistant",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component: component(),
+    });
+    registration.remove();
+    registration.remove();
+    expect(store.getSnapshot().map((entry) => entry.id)).toEqual(["assistant"]);
+  });
+
+  it("updates the component in place and ignores updates after removal", () => {
+    const store = new PluginComposerStatusStore();
+    const source = installation();
+    const registration = store.add(source, {
+      id: "insights",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component: component(),
+    });
+    const replacement = component();
+    registration.update({ Component: replacement });
+    expect(store.getSnapshot()[0]?.Component).toBe(replacement);
+    registration.remove();
+    registration.update({ Component: component() });
+    expect(store.getSnapshot()).toHaveLength(0);
+  });
+
+  it("drops every row from a disposed installation", () => {
+    const store = new PluginComposerStatusStore();
+    const source = installation();
+    store.add(installation("other"), {
+      id: "insights",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component: component(),
+    });
+    store.add(source, {
+      id: "insights",
+      workspaceId: "wks-1",
+      agentId: "agent-1",
+      Component: component(),
+    });
+    store.removeInstallation(source);
+    expect(store.getSnapshot()).toHaveLength(1);
+  });
+});
diff --git a/packages/app/src/plugins/composer-status/store.ts b/packages/app/src/plugins/composer-status/store.ts
new file mode 100644
index 0000000..e0410ca
--- /dev/null
+++ b/packages/app/src/plugins/composer-status/store.ts
@@ -0,0 +1,100 @@
+import type { ComponentType } from "react";
+import type {
+  PluginComposerStatusProps,
+  PluginComposerStatusRegistration,
+} from "@getpaseo/plugin/client";
+import type { InstalledPlugin } from "../types";
+
+const CONTRIBUTION_ID = /^[a-z][a-z0-9-]*$/;
+
+export interface RegisteredPluginComposerStatus {
+  key: number;
+  id: string;
+  installation: InstalledPlugin;
+  workspaceId: string;
+  agentId: string;
+  Component: ComponentType<PluginComposerStatusProps>;
+}
+
+export class PluginComposerStatusStore {
+  private entries: readonly RegisteredPluginComposerStatus[] = [];
+  private nextKey = 0;
+  private listeners = new Set<() => void>();
+
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  getSnapshot = (): readonly RegisteredPluginComposerStatus[] => this.entries;
+
+  add(
+    installation: InstalledPlugin,
+    contribution: {
+      id: string;
+      workspaceId: string;
+      agentId: string;
+      Component: ComponentType<PluginComposerStatusProps>;
+    },
+  ): PluginComposerStatusRegistration {
+    const id = typeof contribution.id === "string" ? contribution.id.trim() : "";
+    if (!CONTRIBUTION_ID.test(id)) throw new Error(`Invalid composer status id: ${id}`);
+    const workspaceId = contribution.workspaceId?.trim() ?? "";
+    const agentId = contribution.agentId?.trim() ?? "";
+    if (!workspaceId) throw new Error("Plugin composer status needs a workspace");
+    if (!agentId) throw new Error("Plugin composer status needs an agent");
+    if (typeof contribution.Component !== "function") {
+      throw new Error(`Composer status ${id} is not a component`);
+    }
+    const duplicate = this.entries.some(
+      (entry) =>
+        entry.installation === installation &&
+        entry.id === id &&
+        entry.workspaceId === workspaceId &&
+        entry.agentId === agentId,
+    );
+    if (duplicate) throw new Error(`Duplicate composer status: ${id}`);
+    const key = this.nextKey++;
+    let active = true;
+    const publish = (Component: ComponentType<PluginComposerStatusProps>) => {
+      if (!active) return;
+      this.entries = [
+        ...this.entries.filter((entry) => entry.key !== key),
+        { key, id, installation, workspaceId, agentId, Component },
+      ];
+      for (const listener of this.listeners) listener();
+    };
+    publish(contribution.Component);
+    return {
+      update: (patch) => {
+        if (!active) return;
+        if (patch.Component !== undefined) {
+          if (typeof patch.Component !== "function") {
+            throw new Error(`Composer status ${id} is not a component`);
+          }
+          publish(patch.Component);
+        }
+      },
+      remove: () => {
+        if (!active) return;
+        active = false;
+        const next = this.entries.filter((entry) => entry.key !== key);
+        if (next.length === this.entries.length) return;
+        this.entries = next;
+        for (const listener of this.listeners) listener();
+      },
+    };
+  }
+
+  /** Drops every status a disposed installation registered. */
+  removeInstallation(installation: InstalledPlugin): void {
+    const next = this.entries.filter((entry) => entry.installation !== installation);
+    if (next.length === this.entries.length) return;
+    this.entries = next;
+    for (const listener of this.listeners) listener();
+  }
+}
+
+export const composerStatusStore = new PluginComposerStatusStore();
