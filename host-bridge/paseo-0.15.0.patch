+import { useMemo, useSyncExternalStore } from "react";
+import { View } from "react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import type { PluginComposerStatusProps } from "@getpaseo/plugin/client";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import { useToast } from "@/contexts/toast-context";
+import { useHostRuntimeClient, useHosts } from "@/runtime/host-runtime";
+import type { Theme } from "@/styles/theme";
+import { createPluginClientStateSource } from "../client-state/source";
+import { resolvePluginPlatform } from "../platform";
+import { PluginEnvironmentProvider } from "../popover";
+import { SurfaceErrorBoundary } from "../surface-error-boundary";
+import { toPluginTheme } from "../theme";
+import { composerStatusStore, type RegisteredPluginComposerStatus } from "./store";
+
+function useComposerStatuses(
+  serverId: string,
+  workspaceId: string,
+  agentId: string,
+): readonly RegisteredPluginComposerStatus[] {
+  const entries = useSyncExternalStore(
+    composerStatusStore.subscribe,
+    composerStatusStore.getSnapshot,
+    composerStatusStore.getSnapshot,
+  );
+  return useMemo(
+    () =>
+      entries.filter(
+        (entry) =>
+          entry.installation.serverId === serverId &&
+          entry.workspaceId === workspaceId &&
+          entry.agentId === agentId,
+      ),
+    [entries, serverId, workspaceId, agentId],
+  );
+}
+
+export function useHasPluginComposerStatus(
+  serverId: string,
+  workspaceId: string,
+  agentId: string,
+): boolean {
+  return useComposerStatuses(serverId, workspaceId, agentId).length > 0;
+}
+
+const pluginThemeMapping = (theme: Theme) => ({ theme: toPluginTheme(theme) });
+
+function renderNothing(): null {
+  return null;
+}
+
+function PluginComposerStatusHost({
+  entry,
+  theme,
+  compact,
+}: {
+  entry: RegisteredPluginComposerStatus;
+  theme: PluginComposerStatusProps["theme"];
+  compact: boolean;
+}) {
+  const client = useHostRuntimeClient(entry.installation.serverId);
+  const toast = useToast();
+  const hosts = useHosts();
+  const hostLabel = hosts.find((host) => host.serverId === entry.installation.serverId)?.label;
+  const environment = useMemo(
+    () => ({
+      installation: entry.installation,
+      toast,
+      state: createPluginClientStateSource(entry.installation.serverId),
+    }),
+    [entry.installation, toast],
+  );
+  if (!client) return null;
+  const Component = entry.Component;
+  const props: PluginComposerStatusProps = {
+    workspaceId: entry.workspaceId,
+    agentId: entry.agentId,
+    theme,
+    host: {
+      id: entry.installation.serverId,
+      label: hostLabel ?? entry.installation.serverId,
+    },
+    layout: { compact, platform: resolvePluginPlatform() },
+  };
+  return (
+    <SurfaceErrorBoundary
+      installation={entry.installation}
+      resetKey={entry.key}
+      Surface={Component}
+      renderError={renderNothing}
+    >
+      <PluginEnvironmentProvider environment={environment}>
+        <Component {...props} />
+      </PluginEnvironmentProvider>
+    </SurfaceErrorBoundary>
+  );
+}
+
+const ThemedStatusHost = withUnistyles(PluginComposerStatusHost);
+
+/**
+ * The row sits directly below the composer and only exists while a plugin contributes to this
+ * exact host, workspace, and agent. It collapses to nothing when the last contribution leaves.
+ */
+export function PluginComposerStatusRow({
+  serverId,
+  workspaceId,
+  agentId,
+}: {
+  serverId: string;
+  workspaceId: string;
+  agentId: string;
+}) {
+  const entries = useComposerStatuses(serverId, workspaceId, agentId);
+  const compact = useIsCompactFormFactor();
+  if (entries.length === 0) return null;
+  return (
+    <View style={styles.row} testID="plugin-composer-status">
+      {entries.map((entry) => (
+        <ThemedStatusHost
+          key={entry.key}
+          entry={entry}
+          compact={compact}
+          uniProps={pluginThemeMapping}
+        />
+      ))}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    flexWrap: "wrap",
+    gap: theme.spacing[2],
+    paddingHorizontal: theme.spacing[3],
+    paddingBottom: theme.spacing[1],
+  },
+}));
