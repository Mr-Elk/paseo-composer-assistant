+++ b/packages/plugin/src/client/composer.ts
@@ -0,0 +1,78 @@
+import type { ComponentType } from "react";
+import type { PluginHostProps } from "./contracts.js";
+import type { PluginText } from "../text.js";
+
+/**
+ * Patched-host composer access. Official Paseo 0.15.x has no equivalent, so plugins must treat
+ * `client.composer` as optional and check `version` before offering draft editing.
+ */
+
+export type PluginComposerImeState = "idle" | "composing" | "unknown";
+
+export interface PluginComposerTarget {
+  workspaceId: string;
+  agentId: string;
+}
+
+export interface PluginComposerSnapshot {
+  workspaceId: string;
+  agentId: string;
+  /** Stable for one draft. Changes when the pane switches to another agent. */
+  draftId: string;
+  /** Increments whenever the text changes, including programmatic replacement. */
+  revision: number;
+  text: string;
+  selection: { start: number; end: number };
+  /** Web reports composition; native reports `unknown` and rejects writes. */
+  ime: PluginComposerImeState;
+  /** Number of attachments on the draft. Host never exposes their contents here. */
+  attachments: number;
+  /** False while the composer is read-only or a send is loading. */
+  editable: boolean;
+}
+
+export interface PluginComposerEdit {
+  draftId: string;
+  /** The revision the plugin read before generating the replacement. */
+  revision: number;
+  range: { start: number; end: number };
+  /** The text the plugin believes occupies `range`. A mismatch rejects the write. */
+  expectedText: string;
+  replacement: string;
+}
+
+export type PluginComposerEditFailure = "unavailable" | "stale" | "mismatch" | "ime" | "read-only";
+
+export type PluginComposerEditResult =
+  | { ok: true; revision: number; undoable: boolean }
+  | { ok: false; reason: PluginComposerEditFailure };
+
+export interface PluginComposerBridge {
+  readonly version: 1;
+  read(target: PluginComposerTarget): PluginComposerSnapshot | null;
+  subscribe(
+    target: PluginComposerTarget,
+    listener: (snapshot: PluginComposerSnapshot | null) => void,
+  ): () => void;
+  apply(target: PluginComposerTarget, edit: PluginComposerEdit): PluginComposerEditResult;
+}
+
+/** One compact row directly below the native composer. */
+export interface PluginComposerStatusProps extends PluginHostProps {
+  workspaceId: string;
+  agentId: string;
+}
+
+export interface PluginComposerStatusContribution<Text extends PluginText = string> {
+  id: string;
+  workspaceId: string;
+  agentId: string;
+  Component: ComponentType<PluginComposerStatusProps>;
+  /** Accessible name for the row when the component renders no text. */
+  label?: Text;
+}
+
+export interface PluginComposerStatusRegistration {
+  update(patch: { Component?: ComponentType<PluginComposerStatusProps> }): void;
+  remove(): void;
+}
