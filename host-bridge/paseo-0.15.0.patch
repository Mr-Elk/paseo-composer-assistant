diff --git a/packages/app/src/plugins/composer-bridge/store.test.ts b/packages/app/src/plugins/composer-bridge/store.test.ts
new file mode 100644
index 0000000..54f9c3a
--- /dev/null
+++ b/packages/app/src/plugins/composer-bridge/store.test.ts
@@ -0,0 +1,179 @@
+import { describe, expect, it, vi } from "vitest";
+import type { PluginComposerEdit, PluginComposerSnapshot } from "@getpaseo/plugin/client";
+import {
+  checkComposerEdit,
+  ComposerBridgeStore,
+  createComposerDraftId,
+  selectionChanged,
+  type ComposerDraftHandle,
+} from "./store";
+
+type Draft = Omit<PluginComposerSnapshot, "workspaceId" | "agentId">;
+
+function draft(overrides: Partial<Draft> = {}): Draft {
+  return {
+    draftId: "composer:host-a:wks-1:agent-1",
+    revision: 3,
+    text: "please improve this sentence",
+    selection: { start: 7, end: 28 },
+    ime: "idle",
+    attachments: 0,
+    editable: true,
+    ...overrides,
+  };
+}
+
+function edit(overrides: Partial<PluginComposerEdit> = {}): PluginComposerEdit {
+  return {
+    draftId: "composer:host-a:wks-1:agent-1",
+    revision: 3,
+    range: { start: 7, end: 28 },
+    expectedText: "improve this sentence",
+    replacement: "make this sentence clearer",
+    ...overrides,
+  };
+}
+
+function handle(state: Draft = draft()) {
+  const reads: Draft[] = [];
+  const writes: PluginComposerEdit[] = [];
+  const value: ComposerDraftHandle = {
+    read: () => {
+      reads.push(state);
+      return state;
+    },
+    apply: (input) => {
+      writes.push(input);
+      return { ok: true, revision: state.revision + 1, undoable: false };
+    },
+  };
+  return { value, reads, writes };
+}
+
+describe("checkComposerEdit", () => {
+  it("gives a remounted editor a different draft id", () => {
+    const before = createComposerDraftId("host-a", "wks-1", "agent-1");
+    const after = createComposerDraftId("host-a", "wks-1", "agent-1");
+    expect(after).not.toBe(before);
+    expect(checkComposerEdit(draft({ draftId: after }), edit({ draftId: before }))).toBe("stale");
+  });
+
+  it("recognizes selection movement without treating identical events as a change", () => {
+    const selected = { start: 2, end: 8 };
+    expect(selectionChanged(null, selected)).toBe(false);
+    expect(selectionChanged(selected, { ...selected })).toBe(false);
+    expect(selectionChanged(selected, { start: 3, end: 8 })).toBe(true);
+    expect(selectionChanged(selected, { start: 2, end: 9 })).toBe(true);
+  });
+  it("accepts a matching revision and range", () => {
+    expect(checkComposerEdit(draft(), edit())).toBeNull();
+  });
+
+  it("refuses when the draft moved past the revision the plugin read", () => {
+    expect(checkComposerEdit(draft({ revision: 4 }), edit())).toBe("stale");
+  });
+
+  it("refuses when the pane switched to another draft", () => {
+    expect(checkComposerEdit(draft({ draftId: "other" }), edit())).toBe("stale");
+  });
+
+  it("refuses when the text under the range changed", () => {
+    expect(checkComposerEdit(draft({ text: "please review this sentence" }), edit())).toBe(
+      "mismatch",
+    );
+  });
+
+  it("refuses out-of-range edits", () => {
+    expect(checkComposerEdit(draft(), edit({ range: { start: 0, end: 999 } }))).toBe("mismatch");
+    expect(checkComposerEdit(draft(), edit({ range: { start: 5, end: 2 } }))).toBe("mismatch");
+    expect(checkComposerEdit(draft(), edit({ range: { start: 1.5, end: 2 } }))).toBe("mismatch");
+  });
+
+  it("refuses during IME composition and when IME state is unknown", () => {
+    expect(checkComposerEdit(draft({ ime: "composing" }), edit())).toBe("ime");
+    expect(checkComposerEdit(draft({ ime: "unknown" }), edit())).toBe("ime");
+  });
+
+  it("refuses while the composer is not editable", () => {
+    expect(checkComposerEdit(draft({ editable: false }), edit())).toBe("read-only");
+  });
+});
+
+describe("ComposerBridgeStore", () => {
+  it("reads through the most recently mounted editor for a target", () => {
+    const store = new ComposerBridgeStore();
+    const first = handle(draft({ text: "first" }));
+    const second = handle(draft({ text: "second" }));
+    const releaseFirst = store.register("host-a", "wks-1", "agent-1", first.value);
+    const releaseSecond = store.register("host-a", "wks-1", "agent-1", second.value);
+    expect(store.read("host-a", { workspaceId: "wks-1", agentId: "agent-1" })?.text).toBe("second");
+    releaseSecond();
+    expect(store.read("host-a", { workspaceId: "wks-1", agentId: "agent-1" })?.text).toBe("first");
+    releaseFirst();
+    expect(store.read("host-a", { workspaceId: "wks-1", agentId: "agent-1" })).toBeNull();
+  });
+
+  it("keeps hosts and agents apart", () => {
+    const store = new ComposerBridgeStore();
+    const hostA = handle(draft({ text: "host a" }));
+    const hostB = handle(draft({ text: "host b" }));
+    store.register("host-a", "wks-1", "agent-1", hostA.value);
+    store.register("host-b", "wks-1", "agent-1", hostB.value);
+    expect(store.read("host-a", { workspaceId: "wks-1", agentId: "agent-1" })?.text).toBe("host a");
+    expect(store.read("host-b", { workspaceId: "wks-1", agentId: "agent-1" })?.text).toBe("host b");
+    expect(store.read("host-a", { workspaceId: "wks-1", agentId: "agent-2" })).toBeNull();
+  });
+
+  it("returns unavailable instead of writing when no editor is mounted", () => {
+    const store = new ComposerBridgeStore();
+    expect(store.apply("host-a", { workspaceId: "wks-1", agentId: "agent-1" }, edit())).toEqual({
+      ok: false,
+      reason: "unavailable",
+    });
+  });
+
+  it("routes writes to the mounted editor", () => {
+    const store = new ComposerBridgeStore();
+    const mounted = handle();
+    store.register("host-a", "wks-1", "agent-1", mounted.value);
+    const result = store.apply("host-a", { workspaceId: "wks-1", agentId: "agent-1" }, edit());
+    expect(result).toEqual({ ok: true, revision: 4, undoable: false });
+    expect(mounted.writes).toHaveLength(1);
+  });
+
+  it("notifies subscribers with the current snapshot, including removal", () => {
+    const store = new ComposerBridgeStore();
+    const target = { workspaceId: "wks-1", agentId: "agent-1" };
+    const seen: (string | null)[] = [];
+    const release = store.subscribe("host-a", target, (snapshot) => {
+      seen.push(snapshot ? snapshot.text : null);
+    });
+    expect(seen).toEqual([null]);
+    const mounted = handle(draft({ text: "hello" }));
+    const unregister = store.register("host-a", "wks-1", "agent-1", mounted.value);
+    store.notify("host-a", "wks-1", "agent-1");
+    unregister();
+    expect(seen).toEqual([null, "hello", "hello", null]);
+    release();
+    store.notify("host-a", "wks-1", "agent-1");
+    expect(seen).toHaveLength(4);
+  });
+
+  it("calls listeners once per notify, not per subscriber mutation", () => {
+    const store = new ComposerBridgeStore();
+    const mounted = handle();
+    store.register("host-a", "wks-1", "agent-1", mounted.value);
+    const listener = vi.fn();
+    const release = store.subscribe(
+      "host-a",
+      { workspaceId: "wks-1", agentId: "agent-1" },
+      listener,
+    );
+    expect(listener).toHaveBeenCalledTimes(1);
+    store.notify("host-a", "wks-1", "agent-1");
+    expect(listener).toHaveBeenCalledTimes(2);
+    release();
+    store.notify("host-a", "wks-1", "agent-1");
+    expect(listener).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/packages/app/src/plugins/composer-bridge/store.ts b/packages/app/src/plugins/composer-bridge/store.ts
new file mode 100644
index 0000000..cc03424
--- /dev/null
+++ b/packages/app/src/plugins/composer-bridge/store.ts
@@ -0,0 +1,136 @@
+import type {
+  PluginComposerEdit,
+  PluginComposerEditFailure,
+  PluginComposerEditResult,
+  PluginComposerSnapshot,
+  PluginComposerTarget,
+} from "@getpaseo/plugin/client";
+
+const SEPARATOR = "\u0000";
+
+let nextDraftInstance = 0;
+
+/** A new mount must never accept a suggestion created for an earlier editor instance. */
+export function createComposerDraftId(
+  serverId: string,
+  workspaceId: string,
+  agentId: string,
+): string {
+  nextDraftInstance += 1;
+  return JSON.stringify([serverId, workspaceId, agentId, nextDraftInstance]);
+}
+
+export function selectionChanged(
+  previous: { start: number; end: number } | null,
+  current: { start: number; end: number },
+): boolean {
+  return previous !== null && (previous.start !== current.start || previous.end !== current.end);
+}
+
+function targetKey(serverId: string, workspaceId: string, agentId: string): string {
+  return [serverId, workspaceId, agentId].join(SEPARATOR);
+}
+
+type DraftSnapshot = Omit<PluginComposerSnapshot, "workspaceId" | "agentId">;
+
+/**
+ * One mounted editor's live draft. The composer registers it for as long as its editor is
+ * mounted; plugins read through the store so a stale registration can never outlive the pane.
+ */
+export interface ComposerDraftHandle {
+  read(): DraftSnapshot;
+  apply(edit: PluginComposerEdit): PluginComposerEditResult;
+}
+
+export function checkComposerEdit(
+  snapshot: DraftSnapshot,
+  edit: PluginComposerEdit,
+): PluginComposerEditFailure | null {
+  if (!snapshot.editable) return "read-only";
+  if (snapshot.ime !== "idle") return "ime";
+  if (edit.draftId !== snapshot.draftId) return "stale";
+  if (edit.revision !== snapshot.revision) return "stale";
+  const { start, end } = edit.range;
+  if (!Number.isInteger(start) || !Number.isInteger(end)) return "mismatch";
+  if (start < 0 || end < start || end > snapshot.text.length) return "mismatch";
+  if (snapshot.text.slice(start, end) !== edit.expectedText) return "mismatch";
+  return null;
+}
+
+export class ComposerBridgeStore {
+  private handles = new Map<string, ComposerDraftHandle[]>();
+  private listeners = new Map<string, Set<() => void>>();
+
+  register(serverId: string, workspaceId: string, agentId: string, handle: ComposerDraftHandle) {
+    const key = targetKey(serverId, workspaceId, agentId);
+    const current = this.handles.get(key);
+    if (current) current.push(handle);
+    else this.handles.set(key, [handle]);
+    this.emit(key);
+    let released = false;
+    return () => {
+      if (released) return;
+      released = true;
+      const remaining = (this.handles.get(key) ?? []).filter((entry) => entry !== handle);
+      if (remaining.length > 0) this.handles.set(key, remaining);
+      else this.handles.delete(key);
+      this.emit(key);
+    };
+  }
+
+  private active(key: string): ComposerDraftHandle | null {
+    const entries = this.handles.get(key);
+    return entries && entries.length > 0 ? entries[entries.length - 1]! : null;
+  }
+
+  read(serverId: string, target: PluginComposerTarget): PluginComposerSnapshot | null {
+    const handle = this.active(targetKey(serverId, target.workspaceId, target.agentId));
+    if (!handle) return null;
+    return { workspaceId: target.workspaceId, agentId: target.agentId, ...handle.read() };
+  }
+
+  subscribe(
+    serverId: string,
+    target: PluginComposerTarget,
+    listener: (snapshot: PluginComposerSnapshot | null) => void,
+  ): () => void {
+    const key = targetKey(serverId, target.workspaceId, target.agentId);
+    let listeners = this.listeners.get(key);
+    if (!listeners) {
+      listeners = new Set();
+      this.listeners.set(key, listeners);
+    }
+    const notify = () => listener(this.read(serverId, target));
+    listeners.add(notify);
+    notify();
+    return () => {
+      const current = this.listeners.get(key);
+      if (!current) return;
+      current.delete(notify);
+      if (current.size === 0) this.listeners.delete(key);
+    };
+  }
+
+  apply(
+    serverId: string,
+    target: PluginComposerTarget,
+    edit: PluginComposerEdit,
+  ): PluginComposerEditResult {
+    const handle = this.active(targetKey(serverId, target.workspaceId, target.agentId));
+    if (!handle) return { ok: false, reason: "unavailable" };
+    return handle.apply(edit);
+  }
+
+  /** A mounted composer calls this when its own draft changed. */
+  notify(serverId: string, workspaceId: string, agentId: string): void {
+    this.emit(targetKey(serverId, workspaceId, agentId));
+  }
+
+  private emit(key: string): void {
+    const listeners = this.listeners.get(key);
+    if (!listeners) return;
+    for (const listener of listeners) listener();
+  }
+}
+
+export const composerBridgeStore = new ComposerBridgeStore();
